#!/usr/bin/env bash
#
# nova-aliases - install short aliases for nova subcommands.
#
# Intended to be sourced from install/applications/nova-cli.sh so it
# inherits p()/e() from install.sh. For each candidate name, check for
# collisions with existing commands, functions, builtins, or aliases;
# write the safe ones to an aliases file and source it from ~/.bashrc.

NAMES=(new tidy jump)
ALIAS_FILE="$HOME/.local/share/nova/aliases.sh"
BASHRC="$HOME/.bashrc"
SOURCE_LINE="[ -f \"$ALIAS_FILE\" ] && . \"$ALIAS_FILE\""

mkdir -p "$(dirname "$ALIAS_FILE")"

safe=()
collisions=()

for name in "${NAMES[@]}"; do
  if command -v "$name" >/dev/null 2>&1; then
    collisions+=("$name -> $(command -v "$name")")
  else
    safe+=("$name")
  fi
done

{
  echo "# nova aliases - generated by nova-aliases"
  echo "# regenerate with: source ${BASH_SOURCE[0]}"
  for name in "${safe[@]}"; do
    echo "alias $name='nova $name'"
  done
} > "$ALIAS_FILE"

if ! grep -qF "$SOURCE_LINE" "$BASHRC" 2>/dev/null; then
  {
    echo ""
    echo "# nova aliases"
    echo "$SOURCE_LINE"
  } >> "$BASHRC"
fi

if [ ${#safe[@]} -gt 0 ]; then
  p "installed aliases: ${safe[*]}"
fi
if [ ${#collisions[@]} -gt 0 ]; then
  e "skipped (collisions):"
  for c in "${collisions[@]}"; do
    e "  $c"
  done
fi
p "wrote $ALIAS_FILE"
p "run 'source ~/.bashrc' or open a new shell to activate."
